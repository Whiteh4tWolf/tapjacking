<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="0dp"
        app:liftOnScroll="true"
        app:liftOnScrollColor="@color/surface_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/app_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_tagline"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="32dp">

            <!-- 1. Permission status — a compact row when granted, expands with a
                 call to action when it is not. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cd_open_settings"
                app:cardBackgroundColor="@color/surface_container"
                app:rippleColor="@color/outline_variant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivPermissionIcon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle"
                            android:backgroundTint="@color/success_container"
                            android:contentDescription="@string/cd_permission_icon"
                            android:padding="9dp"
                            android:src="@drawable/ic_shield_check"
                            app:tint="@color/success" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/section_permission"
                                android:textAppearance="@style/TextAppearance.Tapjacker.CardTitle" />

                            <TextView
                                android:id="@+id/tvPermissionStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/permission_status_denied"
                                android:textColor="@color/danger"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_tertiary" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantPermission"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:text="@string/btn_grant_permission"
                        android:textColor="@color/on_brand_container"
                        app:backgroundTint="@color/brand_container"
                        app:cornerRadius="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Decoy configuration -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/section_config"
                        android:textAppearance="@style/TextAppearance.Tapjacker.CardTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/label_button_text"
                        android:textAppearance="@style/TextAppearance.Tapjacker.Label" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilButtonText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etButtonText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_button_text"
                            android:maxLines="2"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_tertiary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Width -->
                    <LinearLayout style="@style/Widget.Tapjacker.SliderRow">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_width"
                            android:textAppearance="@style/TextAppearance.Tapjacker.Label" />

                        <TextView
                            android:id="@+id/tvWidthValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Tapjacker.Value"
                            tools:text="220 dp" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderWidth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="4"
                        android:value="220"
                        android:valueFrom="80"
                        android:valueTo="360" />

                    <!-- Height -->
                    <LinearLayout style="@style/Widget.Tapjacker.SliderRow">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_height"
                            android:textAppearance="@style/TextAppearance.Tapjacker.Label" />

                        <TextView
                            android:id="@+id/tvHeightValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Tapjacker.Value"
                            tools:text="56 dp" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderHeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="2"
                        android:value="56"
                        android:valueFrom="36"
                        android:valueTo="160" />

                    <!-- Opacity -->
                    <LinearLayout style="@style/Widget.Tapjacker.SliderRow">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_opacity"
                            android:textAppearance="@style/TextAppearance.Tapjacker.Label" />

                        <TextView
                            android:id="@+id/tvOpacityValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Tapjacker.Value"
                            tools:text="100%" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderOpacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="5"
                        android:value="100"
                        android:valueFrom="30"
                        android:valueTo="100" />

                    <!-- Colour -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/label_color"
                        android:textAppearance="@style/TextAppearance.Tapjacker.Label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/swatchRed"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:contentDescription="@string/cd_color_red"
                            android:focusable="true">

                            <View
                                android:id="@+id/ringRed"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_swatch_ring"
                                android:visibility="invisible" />

                            <View
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_color_swatch"
                                android:backgroundTint="@color/decoy_red" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/swatchOrange"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:contentDescription="@string/cd_color_orange"
                            android:focusable="true">

                            <View
                                android:id="@+id/ringOrange"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_swatch_ring"
                                android:visibility="invisible" />

                            <View
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_color_swatch"
                                android:backgroundTint="@color/decoy_orange" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/swatchGreen"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:contentDescription="@string/cd_color_green"
                            android:focusable="true">

                            <View
                                android:id="@+id/ringGreen"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_swatch_ring"
                                android:visibility="invisible" />

                            <View
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_color_swatch"
                                android:backgroundTint="@color/decoy_green" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/swatchBlue"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:contentDescription="@string/cd_color_blue"
                            android:focusable="true">

                            <View
                                android:id="@+id/ringBlue"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_swatch_ring"
                                android:visibility="invisible" />

                            <View
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_color_swatch"
                                android:backgroundTint="@color/decoy_blue" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/swatchPurple"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:contentDescription="@string/cd_color_purple"
                            android:focusable="true">

                            <View
                                android:id="@+id/ringPurple"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_swatch_ring"
                                android:visibility="invisible" />

                            <View
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_color_swatch"
                                android:backgroundTint="@color/decoy_purple" />
                        </FrameLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="20dp"
                        android:background="@color/outline_variant" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchLock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/switch_lock_position"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_hint_box"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:id="@+id/ivHintIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginTop="1dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_info"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvDragHint"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/hint_drag"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Primary action -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShowOverlay"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="20dp"
                android:text="@string/btn_show_overlay"
                android:textColor="@color/on_brand_primary"
                android:textSize="16sp"
                app:backgroundTint="@color/brand_primary"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_play"
                app:iconGravity="textStart"
                app:iconTint="@color/on_brand_primary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
